# Max deployment configuration.
# Copy this file to .env and adjust the values you need.
#
#   cp .env.example .env
#
# Do not commit .env. It is ignored by git.

# Host port exposed by the Max frontend.
CALIVI_PORT=8090

# Session cookie security.
# false is correct for the plain HTTP deployment provided by docker-compose.
# Set to true when Max is behind an HTTPS/TLS-terminating reverse proxy.
COOKIE_SECURE=false

# Signs session cookies AND encrypts secrets stored in the database.
# Generate a strong value with:
#
#   openssl rand -hex 32
#
# Keep this value safe. Anyone who obtains it can forge sessions and decrypt
# stored credentials. Setting it explicitly also keeps the secret out of the
# data-volume backup.
CALIVI_SECRET_KEY=

# Only used during secret-key rotation.
# Put the previous CALIVI_SECRET_KEY here for one boot, then remove this line
# (or leave it empty) after the stored secrets have been re-encrypted.
CALIVI_SECRET_KEY_OLD=

# Seconds of silence permitted while streaming a chat response.
# This is NOT a total response timeout: large prompts can spend this entire
# period in model prefill before the first token is emitted.
#
# 300 is suitable for typical deployments. Local models with very large
# context windows may need a higher value.
OLLAMA_CHAT_TIMEOUT=300

# Maximum time the Max backend waits for the SearXNG search request.
# This covers the SearXNG -> search_service request as seen by the backend.
SEARCH_TIMEOUT=15

# Persistent inference context (experimental).
# auto: enable only after backend/model/runtime compatibility is verified.
# disabled: always use the existing inference path (also the default if unset).
CONTEXT_PERSISTENCE_MODE=disabled

# Save the live slot after this many fully completed assistant turns.
# No disk operation on intervening turns; save-on-switch still applies.
CONTEXT_SNAPSHOT_TURN_INTERVAL=10

# Buun persistence connection (required when CONTEXT_PERSISTENCE_MODE=auto).
# URL must be reachable from the Max backend container, not just the host.
# Adjust the hostname for your Docker network (host.docker.internal is an example).
BUUN_CONTEXT_URL=

# Model alias advertised by Buun's router (for example: Max).
BUUN_CONTEXT_MODEL=

# Stable administrator-chosen identity for this compatible Buun backend.
# Change it if you replace the backend with an incompatible installation.
BUUN_BACKEND_IDENTITY=

# Positive integer ID of the configured inference server in Max.
BUUN_CONTEXT_SERVER_ID=

# Backend-container path for Buun slot files. Compose normally sets this from
# CONTEXT_SNAPSHOT_CONTAINER_PATH; keep the values identical.
BUUN_SLOT_SAVE_PATH=/context-snapshots

# Model files: only required for the optional model-files Compose override.
# Replace the dummy host path in your LOCAL .env.
MODEL_FILES_HOST_PATH=/path/to/your/models
MODEL_FILES_CONTAINER_PATH=/model-files

# Context snapshot storage
#
# Host directory shared between the inference backend and Calivi.
# Must match the directory configured with Buun's --slot-save-path.
#
# Example: /home/youruser/AI/slot-snapshots
CONTEXT_SNAPSHOT_HOST_PATH=/path/to/your/snapshots

# Path inside the Calivi backend container.
CONTEXT_SNAPSHOT_CONTAINER_PATH=/context-snapshots
